    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.2</Version>
    <Authors>Andrei Yakovlev</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
