<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.2</Version>
    <Authors>Andrei Yakovlev</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AndreiYakovlev/VidCropper</RepositoryUrl>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;downloads/**;output/**;temp/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="licenses/ai/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**;tools/**;artifacts/**" />
    <None Remove="tools/**" />
  </ItemGroup>
</Project>
